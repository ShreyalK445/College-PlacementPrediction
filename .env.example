# ============================================================
# College Placement Prediction — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# Application environment: development | staging | production
FLASK_ENV=development

# Secret key for Flask session signing (generate a strong random value)
SECRET_KEY=change-me-to-a-random-secret

# API key for authenticated endpoints (leave blank to disable auth)
API_KEY=your-api-key-here

# Server
HOST=0.0.0.0
PORT=5000

# Rate limiting (requests per minute per IP)
RATE_LIMIT=60

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Model path (relative to project root)
MODEL_PATH=model.pkl
MODEL_METADATA_PATH=model_metadata.json

# CORS allowed origins (comma-separated, * for all)
CORS_ORIGINS=*

# Database URL (SQLite default: sqlite:///placement_platform.db | PostgreSQL: postgresql://user:pwd@localhost:5432/placement)
DATABASE_URL=sqlite:///placement_platform.db

# Optional External AI Mentor Key (leave blank to use the domain-trained deterministic mentor engine)
OPENAI_API_KEY=your-openai-api-key-here
